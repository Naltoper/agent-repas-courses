# SmartChef Agent — Backend environment
# Copy to .env locally. On Render, set these in the dashboard.

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Required
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash
AGENT_MAX_TOOL_ROUNDS=6

# Local without Postgres: JSON files under DATA_DIR
DATA_DIR=data

# Production (Render)
# APP_ENV=production
# FRONTEND_ORIGIN=https://YOUR-APP.vercel.app
# DATA_DIR=/tmp/smartchef-data
# Optional durable history (Neon Free recommended — see DEPLOY.md):
# DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require

# Later phases (optional)
YOUTUBE_API_KEY=
GOOGLE_KEEP_EMAIL=
GOOGLE_KEEP_MASTER_TOKEN=
