# SmartChef Agent — Backend environment
# Copy to .env locally. On Northflank, set these in the service secrets.

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Required
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash
AGENT_MAX_TOOL_ROUNDS=6

# Local without Postgres: JSON files under DATA_DIR
DATA_DIR=data

# Production (Northflank) — link addon secrets or paste URI
# APP_ENV=production
# FRONTEND_ORIGIN=https://YOUR-APP.vercel.app
# DATABASE_URL=postgresql://user:pass@host:5432/northflank
# (POSTGRES_URI from the Northflank addon also works if DATABASE_URL is empty)

# Later phases (optional)
YOUTUBE_API_KEY=
GOOGLE_KEEP_EMAIL=
GOOGLE_KEEP_MASTER_TOKEN=
