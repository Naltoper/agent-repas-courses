# SmartChef Agent — Backend environment
# Copy to .env and fill in values before later phases.

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Required from P2+
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AGENT_MAX_TOOL_ROUNDS=6

# Required from P4+
YOUTUBE_API_KEY=

# Required from P5+ (gkeepapi master token — treat like a password)
GOOGLE_KEEP_EMAIL=
GOOGLE_KEEP_MASTER_TOKEN=

# Local data directory (relative to backend working directory)
DATA_DIR=data
